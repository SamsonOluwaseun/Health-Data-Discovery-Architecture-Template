<!--
  Gov Health Data Discovery Template
  File: 03_data_flow_diagram.drawio
  Purpose: End-to-end data flow diagram — 3 critical health data journeys
  Usage: Open at app.diagrams.net → File → Open from Device
  Customise: Replace [SYSTEM] labels with actual system names
  
  Three journeys shown:
    Journey 1 — Patient Demographics (PAS → Analytics)
    Journey 2 — Lab Results (LIMS → Clinician → Reporting)
    Journey 3 — Referral Pathway (GP → Acute → RTT Dashboard)
-->
<mxGraphModel dx="1654" dy="826" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
